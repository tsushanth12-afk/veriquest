# ==========================================================================
# VeriQuest — Environment Variables
# ==========================================================================

# Supabase (asymmetric JWT verification — no shared signing secret needed)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_KEY=eyJ...your-service-key

# Disposable local Auth: ES256 only. Hosted setups must replace issuer/JWKS explicitly.
JWT_ISSUER=http://127.0.0.1:54321/auth/v1
JWT_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# Container JWKS transport may use host.docker.internal:54321; keep issuer unchanged.
JWT_ALGORITHMS=ES256
JWT_AUDIENCE=authenticated
# Documented clock skew: 30 seconds; permitted configuration range 0..60.
JWT_CLOCK_TOLERANCE_SECONDS=30

# Database (use Supabase connection string)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Execution
EXECUTION_IMAGE=veriquest-icarus:latest
EXECUTION_TIMEOUT_MS=5000
EXECUTION_MEMORY_MB=256
EXECUTION_CPU_LIMIT=1.0
MAX_SUBMISSION_BYTES=65536
MAX_OUTPUT_BYTES=65536

# Worker
WORKER_CONCURRENCY=4

# Frontend (Vite env vars — must start with VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
VITE_API_BASE_URL=http://localhost:8000
